{
  "name": "btc-contrakt",
  "version": "1.0.0",
  "description": "Bitcoin Mining Platform with Cloud Mining, Rewards, Wallet & Hardware Management",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm run client:build && npm run server:build",
    "start": "node dist/server/index.js",
    "server:dev": "nodemon --exec ts-node src/server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "client:dev": "vite",
    "client:build": "vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "web3": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "zustand": "^4.4.1",
    "recharts": "^2.10.3",
    "axios-instance": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.1.0",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "@types/node": "^20.8.9",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.31",
    "concurrently": "^8.2.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0"
  }
}
